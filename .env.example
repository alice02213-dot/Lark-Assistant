# Lark App Credentials — create an app at https://open.feishu.cn/app
LARK_APP_ID=cli_xxxxxxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Calendar to write holiday events into. Use "primary" for the bot's primary
# calendar or a specific calendar ID for a shared/resource calendar.
LARK_CALENDAR_ID=primary

# Timezone for the birthday cron job (node-cron format)
CRON_TIMEZONE=Asia/Hong_Kong

# Set to "true" to log all Lark API requests and responses
LARK_DEBUG=true

# Internal backend port (Docker maps this)
PORT=3001

# Override data directory (default: /app/data in prod, ./data in dev)
# DATA_DIR=/app/data

# Frontend build-time API base URL (value is /api when behind the nginx proxy)
VITE_API_BASE_URL=/api
